{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build and run",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-stdlib=libc++",
                "-arch", "arm64",
                "-Wall",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            // ← Вот это добавляет запуск после успешной сборки
            "command": "/bin/sh",
            "args": [
                "-c",
                "cd \"${fileDirname}\" && /usr/bin/clang++ -std=c++17 -stdlib=libc++ -arch arm64 -Wall -g \"${file}\" -o \"${fileBasenameNoExtension}\" && \"./${fileBasenameNoExtension}\""
            ]
        }
    ]
}